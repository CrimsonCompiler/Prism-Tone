# Prism Tone API configuration (all optional)

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Set to 0 to disable live NASA POWER / FIRMS calls entirely (cache only).
PRISM_TONE_LIVE=1

# Optional NASA FIRMS MAP_KEY. Without it /api/hotspots serves the cached
# GIBS aggregate and never fabricates live detections.
FIRMS_MAP_KEY=

# Set to 1 only on a private deployment if you want /api/cache/clear enabled.
PRISM_TONE_ALLOW_CACHE_CLEAR=0
